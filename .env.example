# Backend server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
STOREFRONT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# Frontend only: public backend origin. Leave blank for local Vite proxy.
VITE_API_BASE_URL=

# Dev Mode credentials — use long random values; never commit your real .env
DEV_MODE_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# FamGateway — secret belongs ONLY on the backend
FAMGATEWAY_ENABLED=false
FAMGATEWAY_API_KEY=

# Payment provider: famgateway or cashfree (switch this value to change UPI gateway)
PAYMENT_PROVIDER=famgateway

# Cashfree PG credentials — keep server-side only
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2025-01-01

# Checkout switches
COD_ENABLED=false

# Storage paths (use a persistent volume in production)
DATABASE_PATH=server/kinetic-grooves.sqlite
UPLOAD_DIR=server/uploads

# Paid-order email notifications (Resend)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_NOTIFICATION_FROM=

# Merch Factory automatic fulfilment — OFF by default; only enable after SKU mapping and wallet checks
MERCH_FACTORY_AUTO_FULFILLMENT=false
MF_API_KEY=
MF_WEBHOOK_SECRET=
MF_DEFAULT_COURIER=cheapest
# SKU mapping: one saved Merch Factory SKU for each KG product colour and size
MF_SKU_THE_PERFECT_MAN_VINTAGE_IVORY_S=
MF_SKU_THE_PERFECT_MAN_VINTAGE_IVORY_M=
MF_SKU_THE_PERFECT_MAN_VINTAGE_IVORY_L=
MF_SKU_THE_PERFECT_MAN_VINTAGE_IVORY_XL=
MF_SKU_THE_PERFECT_MAN_OBSIDIAN_S=
MF_SKU_THE_PERFECT_MAN_OBSIDIAN_M=
MF_SKU_THE_PERFECT_MAN_OBSIDIAN_L=
MF_SKU_THE_PERFECT_MAN_OBSIDIAN_XL=
