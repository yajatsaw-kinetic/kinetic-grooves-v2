# Backend server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
STOREFRONT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# Frontend only: public backend origin. Leave blank for local Vite proxy.
VITE_API_BASE_URL=

# Dev Mode credentials — use long random values; never commit your real .env
DEV_MODE_PASSWORD=change-this-to-a-long-unique-password
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# FamGateway — secret belongs ONLY on the backend
FAMGATEWAY_ENABLED=false
FAMGATEWAY_API_KEY=

# Checkout switches
COD_ENABLED=false

# Storage paths (use a persistent volume in production)
DATABASE_PATH=server/kinetic-grooves.sqlite
UPLOAD_DIR=server/uploads
